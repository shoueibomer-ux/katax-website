<svg width="1050" height="600" viewBox="0 0 350 200" xmlns="http://www.w3.org/2000/svg" font-family="'IBM Plex Sans','Helvetica Neue',Arial,sans-serif">
<defs><clipPath id="cardClip"><rect x="0" y="0" width="350" height="200"/></clipPath></defs>
<g clip-path="url(#cardClip)">

  <!-- Base: light warm terracotta field -->
  <rect x="0" y="0" width="350" height="200" fill="#EFDCD2"/>

  <!-- Curved navy block, right side -->
  <circle cx="400" cy="100" r="175" fill="#16213E"/>

  <!-- Logo lockup, on the navy curve -->
  <g transform="translate(272, 24)">
    <rect x="0" y="7" width="5" height="17" fill="#C0272D"/>
    <rect x="7" y="1" width="5" height="23" fill="#FFFFFF"/>
    <rect x="14" y="10" width="5" height="14" fill="#1C7A3B"/>
    <text x="24" y="15" font-size="12.5" font-weight="700" fill="#FFFFFF" letter-spacing="0.3">KATAX</text>
    <text x="24" y="23" font-size="4.6" font-weight="500" fill="#B9C4D6" letter-spacing="0.4">ACCOUNTING &amp; TAX</text>
  </g>

  <!-- Name and title -->
  <text x="24" y="52" font-size="18" font-weight="700" fill="#16213E">ESSA ISMAIL</text>
  <text x="24" y="65" font-size="9" font-weight="600" fill="#1B1B1B" letter-spacing="0.5">PRINCIPAL</text>

  <!-- Divider -->
  <line x1="24" y1="75" x2="160" y2="75" stroke="#16213E" stroke-width="0.6" opacity="0.35"/>

  <!-- Contact rows with icon badges -->
  <g font-size="8" fill="#2A241F" font-weight="500">

    <!-- phone -->
    <circle cx="33" cy="93" r="9.5" fill="#1B1B1B"/>
    <g transform="translate(28.3, 88.3)" stroke="#FFFFFF" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M0 1h2.6l1.1 3-1.6 1.3a9.6 9.6 0 0 0 5 5l1.3-1.6 3 1.1v2.6c0 .9-.8 1.6-1.6 1.6C4.9 14 .8 9.9 0 4.4c0-.8.7-1.6.8-2.4z" transform="scale(0.62)"/>
    </g>
    <text x="49" y="91">437-230-5860</text>
    <text x="49" y="100" font-size="6.5" fill="#5C5147">Call or text anytime</text>

    <!-- email + website -->
    <circle cx="33" cy="118" r="9.5" fill="#1B1B1B"/>
    <g transform="translate(27, 113.3)" stroke="#FFFFFF" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <rect x="0" y="0" width="12" height="8.6" rx="1" transform="scale(0.88)"/>
      <path d="M0.4 0.7 6 5.6 11.5 0.7" transform="scale(0.88)"/>
    </g>
    <text x="49" y="116">admin@katax.ca</text>
    <text x="49" y="125" font-size="6.5" fill="#5C5147">www.katax.ca</text>

    <!-- address -->
    <circle cx="33" cy="143" r="9.5" fill="#1B1B1B"/>
    <g transform="translate(29, 137.6)" stroke="#FFFFFF" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12s4.3-3.9 4.3-7.2A4.3 4.3 0 0 0 0.7 4.8C0.7 8.1 5 12 5 12z" transform="scale(0.78)"/>
      <circle cx="5" cy="4.8" r="1.5" transform="scale(0.78)"/>
    </g>
    <text x="49" y="141">Toronto, ON</text>
    <text x="49" y="150" font-size="6.5" fill="#5C5147">M1E 4Y2</text>
  </g>

